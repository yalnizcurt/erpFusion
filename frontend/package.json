    "@types/node": "26.6.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "30.1.1",
    "oxlint": "^1.81.0",
    "typescript": "7.0.2",
