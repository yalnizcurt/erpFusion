# Set this to the deployed API service origin, with no /api suffix.
# Leave empty for local development; Vite proxies /api to localhost:8000.
VITE_API_BASE_URL=

# Configure all five values for hosted OIDC sign-in. Leave all empty for local fixtures.
# Use a public app client without a client secret and enable authorization-code flow.
# Cognito allowed scopes: openid, email, profile.
# Callback URL: https://YOUR_FRONTEND_ORIGIN/auth/callback
# Allowed sign-out URL: https://YOUR_FRONTEND_ORIGIN/
VITE_OIDC_ISSUER=
VITE_OIDC_CLIENT_ID=
VITE_OIDC_AUTHORIZATION_ENDPOINT=
VITE_OIDC_TOKEN_ENDPOINT=
VITE_OIDC_LOGOUT_ENDPOINT=
