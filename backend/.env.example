# erpFusion Backend Environment Variables
# Copy this file to .env and fill in the values

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/erpfusion
# Cloud PostgreSQL: verify TLS using the deployed provider CA bundle.
# DATABASE_SSL_CA_FILE=/app/rds-ca-bundle.pem

# Groq is local development only. Staging/production MUST set LLM_PROVIDER=bedrock.
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Explicit offline demo: LLM_PROVIDER=mock and DEMO_MODE=true (development/test only).
DEMO_MODE=false

# Optional cloud storage uses the deployed IAM role; install the [aws] package extra.
AWS_REGION=us-east-1

# Bedrock uses the default SDK credential chain / workload IAM role; no copied keys.
# Pin direct regional Nova Pro. Cross-region/global inference profiles are rejected.
BEDROCK_MODEL_ID=amazon.nova-pro-v1:0
BEDROCK_REGION=us-east-1
BEDROCK_API=converse
# Temperature is resolved from the request's pinned ERP profile generation settings.
BEDROCK_MAX_TOKENS=5000
BEDROCK_MAX_INPUT_BYTES=262144
BEDROCK_TIMEOUT_SECONDS=120
BEDROCK_CONNECT_TIMEOUT_SECONDS=5
BEDROCK_MAX_ATTEMPTS=2
# Production requires an explicit provisioned regional runtime PrivateLink endpoint.
# Restrict IAM/endpoint policies to this model and aws:SourceVpce. TLS stays verified.
# BEDROCK_ENDPOINT_URL=https://vpce-<id>.bedrock-runtime.us-east-1.vpce.amazonaws.com
BEDROCK_ENDPOINT_URL=
# Set true only after approval of account/model/API retention and Region residency,
# enforcement of account retention=none where applicable, and disabling content-bearing
# invocation logging. These attestations neither change AWS policy nor establish ZDR.
BEDROCK_RETENTION_APPROVED=false
BEDROCK_RESIDENCY_APPROVED=false
BEDROCK_INVOCATION_LOGGING_DISABLED=false

# ERP connections store operation-scoped Secrets Manager references, never passwords.
ERP_ALLOWED_HOSTS=[]
ERP_SECRET_PREFIX=
ERP_SECRET_KMS_KEY_ID=
ERP_CONNECTION_TIMEOUT_SECONDS=10
ERP_PROBE_TTL_SECONDS=300
ERP_MAX_RESPONSE_BYTES=8388608

# Requirement uploads: a trusted, pre-installed local scanner executable and its args.
# The parser runs in a bounded isolated process; PDFs requiring OCR remain blocked.
# Production/staging require a CLEAN scan. No external upload/scanning service is used.
REQUIREMENT_SCAN_COMMAND=[]
# Example when ClamAV is provisioned: ["/usr/bin/clamdscan","--no-summary"]

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# Application
APP_ENV=development
LOG_LEVEL=INFO

# Provision this directory explicitly before starting the API.
ARTIFACT_STORAGE_PATH=./artifacts
ARTIFACT_STORAGE_BACKEND=local
# S3 deployment: ARTIFACT_STORAGE_BACKEND=s3 and a private pre-provisioned bucket.
# ARTIFACT_S3_BUCKET=

# Explicit local fixture identity. Never accepted in staging/production.
AUTH_MODE=development
DEV_IDENTITY_USER_ID=development-fixture
DEV_IDENTITY_ROLES=["platform_admin"]
DEV_IDENTITY_ALLOW_CLAIMED_CLIENTS=false
DEV_IDENTITY_ALLOW_LEGACY_DATA=false

# Production: AUTH_MODE=oidc; configure the real organization's token issuer.
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_AUDIENCE_CLAIM=aud
OIDC_TOKEN_USE=
# Cognito access tokens: OIDC_AUDIENCE_CLAIM=client_id, OIDC_TOKEN_USE=access,
# OIDC_AUDIENCE=<Cognito app client ID>; issuer and JWKS stay pinned.
OIDC_JWKS_URL=
OIDC_ALGORITHMS=["RS256","ES256"]
# Optional server-side token/session revocation check (no positive-result cache).
OIDC_INTROSPECTION_URL=
OIDC_INTROSPECTION_CLIENT_ID=
OIDC_INTROSPECTION_CLIENT_SECRET=

# Use a non-owner, non-superuser PostgreSQL role for DATABASE_URL.
# Privileged schema migration/first-administrator tooling uses a separate secret:
# MIGRATION_DATABASE_URL=
