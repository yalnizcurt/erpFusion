# erpFusion Backend Environment Variables
# Copy this file to .env and fill in the values

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/erpfusion

# LLM Provider: "groq" or "bedrock"
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here

# AWS Bedrock (production)
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

# Application
APP_ENV=development
LOG_LEVEL=INFO

# Artifact storage
ARTIFACT_STORAGE_PATH=./artifacts

# ERP Profile administration (required to enable Admin → ERP Profiles)
ERP_ADMIN_API_KEY=replace_with_a_long_random_secret
